# DPD Explores - Environment Variables Reference

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Direct Connection (for Better Auth server-side)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres

# Better Auth
BETTER_AUTH_SECRET=generate-with: openssl rand -base64 32
VITE_API_URL=http://localhost:5173  # or your Vercel deployment URL

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxx

# Google Maps Places API (Server-side only)
GMAPS_API_KEY=AIza...

# Groq API (Server-side only)
GROQ_API_KEY=gsk_...

# Deployment
VITE_APP_URL=https://your-domain.com  # Set for production
